{%- style -%}
  .as-seen-in-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

 .logo-bar-label {
    display: inline-block;
    background: #cfc3b8;
    color: #ffffff;
    padding: 12px 25px;
    border-radius: 50px;
    font-size: 16px;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 40px;
    display: none;
}

  .logo-bar-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 90px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .logo-bar-item img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    filter: brightness(0) invert(1); /* Logos ko white karne ke liye */
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .logo-bar-item img:hover {
    opacity: 1;
  }

  @media screen and (max-width: 767px) {
    .logo-bar-container {
        gap: 25px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
    }
    .logo-bar-item img {
      max-width: 120px;
    }
  }
{%- endstyle -%}

<div class="as-seen-in-{{ section.id }}">
  {% if section.settings.title != blank %}
    <span class="logo-bar-label">{{ section.settings.title }}</span>
  {% endif %}

  <div class="logo-bar-container">
    {% for block in section.blocks %}
      <div class="logo-bar-item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "As Seen In",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Label Text",
      "default": "AS SEEN IN"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#b19c89"
    },
    {
      "type": "color",
      "id": "label_bg_color",
      "label": "Label Background",
      "default": "#cfc3b8"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Max Width",
      "min": 100,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen In",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}