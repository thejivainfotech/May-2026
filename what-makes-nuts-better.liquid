{% comment %} what-makes-nuts-better.liquid {% endcomment %}

<div class="wmnb-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="wmnb-inner {% if section.settings.image_position == 'right' %}wmnb-image-right{% endif %}">

    {%- if section.settings.image != blank -%}
      <div class="wmnb-image-col">
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="wmnb-image"
        >
      </div>
    {%- endif -%}

    <div class="wmnb-content-col">
      {%- if section.settings.heading != blank -%}
        <h2 class="wmnb-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="wmnb-features">
        {%- for block in section.blocks -%}
          <div class="wmnb-feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.feature_title != blank -%}
              <p class="wmnb-feature-title">{{ block.settings.feature_title }}</p>
            {%- endif -%}
            {%- if block.settings.feature_text != blank -%}
              <p class="wmnb-feature-text">{{ block.settings.feature_text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="wmnb-btn-wrap">
          <a href="{{ section.settings.button_url }}" class="wmnb-btn">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  
 
  .wmnb-image-right {
    flex-direction: row-reverse;
  }
  .wmnb-image-col {
    flex: 0 0 60%;
    max-width: 60%;
  }
  .wmnb-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .wmnb-content-col {
    flex: 1;
    min-width: 280px;
  }
  .wmnb-heading {
    font-size: 48px;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 30px 0;
    color: {{ section.settings.heading_color }};
  }
  .wmnb-features {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
    width: 100%;
    align-items: end;
  }
  .wmnb-feature-item {
    text-align: right;
    width: 100%;
    max-width: 370px;
  }
  .wmnb-feature-title {
    font-size: 19px;
    font-weight: 700;
    margin: 0 0 6px 0;
    color: {{ section.settings.feature_title_color }};
    line-height: 1.3;
  }
  .wmnb-feature-text {
    font-size: 19px;
    font-weight: 500;
    margin: 0;
    color: #838f9f;
    line-height: 1.14;
  }
  .wmnb-btn-wrap {
    display: flex;
    justify-content: flex-end;
  }
  .wmnb-btn {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    padding: 10px 40px;
    border-radius: 50px;
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -44;
    line-height: 1.18;
    transition: opacity 0.2s ease;
    font-family: "Antonio", sans-serif;
  }
  @media (max-width: 768px) {
    .wmnb-section {
      padding: 40px 20px 20px 20px !important;
    }
    .wmnb-inner {
      gap: 50px;
    }
    .wmnb-inner,
    .wmnb-image-right {
      flex-direction: column;
    }
    .wmnb-image-col {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .wmnb-feature-item {
      text-align: center;
    }
    .wmnb-btn-wrap {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "What Makes Nuts Better",
  "tag": "section",
  "class": "what-makes-nuts-better",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Image Left" },
        { "value": "right", "label": "Image Right" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Feature Text Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Makes Nuts Better?"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "They make sauce creamy"
        },
        {
          "type": "textarea",
          "id": "feature_text",
          "label": "Feature Description",
          "default": "Nuts give sauces a naturally smooth, full-bodied texture."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What Makes Nuts Better",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "feature_title": "They make sauce creamy",
            "feature_text": "Nuts give sauces a naturally smooth, full-bodied texture. That is why our sauces feel rich without needing to rely on the usual shortcuts."
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "feature_title": "They add real flavor",
            "feature_text": "Cashew is smooth and mellow. Pecan is warm and bold. Pistachio is rich, green and punchy. Every nut brings its own personality."
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "feature_title": "They bring more value",
            "feature_text": "Nuts contain fiber, plant protein and healthy fats, which help make food feel more satisfying."
          }
        }
      ]
    }
  ]
}
{% endschema %}