{% comment %}
========================================================================
TJI Infinite Product Slider
FULL WORKING SECTION
========================================================================
✔ Infinite Slick Slider
✔ Variable Width Cards
✔ Custom Width
✔ Center Mode
✔ Mobile Responsive
✔ Shopify Customizer Ready
========================================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css">

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>

<style>
  #nut-slider-{{ section.id }}{
    --bg: {{ section.settings.background_color }};
    --accent: {{ section.settings.accent_color }};
    --heading: {{ section.settings.heading_color }};
    --radius: {{ section.settings.card_radius }}px;

    background: var(--bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  #nut-slider-{{ section.id }} *{
    box-sizing:border-box;
  }

  /* =========================
      Heading
  ========================== */

  #nut-slider-{{ section.id }} .nut-slider__heading{
    text-align:center;
    font-size:clamp(34px,5vw,64px);
    line-height:1;
    text-transform:uppercase;
    letter-spacing:.04em;
    color:var(--heading);
    width: 800px;
    margin: 0 auto;
    padding-bottom: 25px;
    padding:1px 0px 35px;
  }

  /* =========================
      Pill Nav
  ========================== */

  #nut-slider-{{ section.id }} .nut-slider__pill-wrap{
    display:flex;
    justify-content:center;
    margin-bottom:40px;
  }

  #nut-slider-{{ section.id }} .nut-slider__pill{
    display:flex;
    align-items:center;
    gap:14px;
    background:var(--accent);
    color:#fff;
    border-radius:999px;
    padding:12px 20px;
    font-family:'Bebas Neue',sans-serif;
    font-size:30px;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
#nut-slider-{{ section.id }} .nut-slider__arrow span{
    display:flex;
    align-items:center;
    justify-content:center;
    transform: translateY(-1px);
    {% comment %} font-size: 35px;
    font-weight: 700; {% endcomment %}
}
 #nut-slider-{{ section.id }} .nut-slider__arrow{
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(180deg, #3b4652 0%, #1f2730 100%);
  border: 2px solid #59626d;

  display: flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;

  color: #fff !important;

  font-size: 0; /* IMPORTANT: hide raw text baseline issue */
  padding: 0;
  line-height: 1;
}

/* ICON INSIDE */
#nut-slider-{{ section.id }} .arrow-icon{
  font-size: 26px;
  font-weight: 700;
  line-height: 1;

  display: flex;
  align-items: center;
  justify-content: center;

  transform: translateY(-1px);
  color: #fff;
}
 

 
 

  /* =========================
      Slider
  ========================== */

  #nut-slider-{{ section.id }} .nut-slider{
    opacity:0;
    transition:opacity .3s ease;
  }

  #nut-slider-{{ section.id }} .nut-slider.slick-initialized{
    opacity:1;
  }

  #nut-slider-{{ section.id }} .slick-list{
    {% comment %} overflow:visible; {% endcomment %}
    padding:30px 0 !important;
    width: 1300px !important;
    margin: 0 auto;
  }

  #nut-slider-{{ section.id }} .slick-track{
    display:flex !important;
    align-items:stretch;
  }

  #nut-slider-{{ section.id }} .slick-slide{
    width:auto !important;
    padding:0 {{ section.settings.card_gap | divided_by: 2 }}px;
    height:auto;
    transition:transform .3s ease;
  }

  #nut-slider-{{ section.id }} .slick-slide > div{
    height:100%;
    
  }

  /* =========================
      Card
  ========================== */

  #nut-slider-{{ section.id }} .nut-card{
     width:{{ section.settings.card_width }}px;
  aspect-ratio:3/4;
  position:relative;
  overflow:hidden;
  border-radius:var(--radius);
  background:transparent;
  cursor:pointer;
  transition:.35s ease;
  {% comment %} box-shadow:0 8px 28px rgba(0,0,0,.18); {% endcomment %}
  }

  #nut-slider-{{ section.id }} .slick-center .nut-card{
    {% comment %} transform:scale(1.06); {% endcomment %}
    {% comment %} box-shadow:0 20px 50px rgba(0,0,0,.30); {% endcomment %}
  }

  #nut-slider-{{ section.id }} .nut-card__image{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .5s ease;
  }

  #nut-slider-{{ section.id }} .nut-card:hover .nut-card__image{
    transform:scale(1.05);
  }

  #nut-slider-{{ section.id }} .nut-card__overlay{
    position:absolute;
    inset:0;
    {% comment %} background:linear-gradient(
      to top,
      rgba(0,0,0,.84) 0%,
      rgba(0,0,0,.18) 48%,
      transparent 100%
    ); {% endcomment %}
  }

  #nut-slider-{{ section.id }} .nut-card__label{
    position:absolute;
    left:18px;
    right:18px;
    bottom:18px;
    z-index:2;
    color:#fff;
    {% comment %} font-family:'Bebas Neue',sans-serif; {% endcomment %}
    font-size:clamp(22px,2vw,34px);
    line-height:1;
    letter-spacing:.05em;
    text-transform:uppercase;
    text-align: center;
    padding-bottom: 30px;
  }

  #nut-slider-{{ section.id }} .nut-card__badge{
    position:absolute;
    top:14px;
    right:14px;
    z-index:2;
    background:var(--accent);
    color:#fff;
    border-radius:999px;
    padding:5px 10px;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.08em;
    font-family:'Barlow Condensed',sans-serif;
  }

  /* =========================
      Dots
  ========================== */

  #nut-slider-{{ section.id }} .slick-dots{
    bottom:-40px;
  }

  #nut-slider-{{ section.id }} .slick-dots li button:before{
    font-size:10px;
    opacity:.3;
  }

  #nut-slider-{{ section.id }} .slick-dots li.slick-active button:before{
    opacity:1;
    color:var(--accent);
  }

  /* =========================
      CTA
  ========================== */

  #nut-slider-{{ section.id }} .nut-slider__cta-wrap{
    display:flex;
    justify-content:center;
    margin-top:{{ section.settings.cta_margin_top }}px;
  }

  #nut-slider-{{ section.id }} .nut-slider__cta{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--accent);
    color:#fff;
    text-decoration:none;
    border-radius:999px;
    padding:15px 34px;
    {% comment %} font-family:'Bebas Neue',sans-serif; {% endcomment %}
    font-size:22px;
    text-transform:uppercase;
    letter-spacing:.08em;
    transition:.25s ease;
  }

  #nut-slider-{{ section.id }} .nut-slider__cta:hover{
    transform:translateY(-2px);
    opacity:.92;
  }

  /* =========================
      Mobile
  ========================== */

  @media screen and (max-width:768px){

    #nut-slider-{{ section.id }} .nut-slider__heading{
      font-size:40px;
      width:auto;
    }

    #nut-slider-{{ section.id }} .nut-slider__pill{
      font-size:16px;
      padding:10px 14px;
      gap:10px;
      margin:0 14px;
      text-align:center;
    }

    #nut-slider-{{ section.id }} .nut-slider__arrow{
      width:30px;
      height:30px;
      font-size:15px;
    }

    #nut-slider-{{ section.id }} .slick-slide{
      padding:0 8px;
    }

    #nut-slider-{{ section.id }} .nut-card{
      width:78vw;
    }

    #nut-slider-{{ section.id }} .slick-center .nut-card{
      transform:scale(1.02);
    }
  }
</style>

<section id="nut-slider-{{ section.id }}">

  {% if section.settings.heading != blank %}
    <h2 class="nut-slider__heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="nut-slider__pill-wrap">

    <div class="nut-slider__pill">

      <button
        class="nut-slider__arrow"
        id="nut-prev-{{ section.id }}"
        aria-label="Previous"
      >
       <span class="arrow-icon">‹</span>
      </button>

      {{ section.settings.pill_label }}

      <button
        class="nut-slider__arrow"
        id="nut-next-{{ section.id }}"
        aria-label="Next"
      >
       <span class="arrow-icon"> › </span>
      </button>

    </div>

  </div>

  <div
  class="nut-slider"
  id="nut-slider-track-{{ section.id }}"
  data-section-id="{{ section.id }}"
>

    {% for block in section.blocks %}

      {% assign product = all_products[block.settings.product] %}

      <div {{ block.shopify_attributes }}>

        <div
          class="nut-card"
          {% if block.settings.custom_link != blank %}
            onclick="window.location='{{ block.settings.custom_link }}'"
          {% elsif product != blank %}
            onclick="window.location='{{ product.url }}'"
          {% endif %}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'nut-card__image',
                loading: 'lazy',
                alt: block.settings.label
            }}

          {% elsif product.featured_image != blank %}

            {{
              product.featured_image
              | image_url: width: 1000
              | image_tag:
                class: 'nut-card__image',
                loading: 'lazy',
                alt: product.title
            }}

          {% else %}

            {{ 'product-1' | placeholder_svg_tag: 'nut-card__image' }}

          {% endif %}

          <div class="nut-card__overlay"></div>

          {% if block.settings.badge_text != blank %}
            <div class="nut-card__badge">
              {{ block.settings.badge_text }}
            </div>
          {% endif %}

          <div class="nut-card__label">
            {{ block.settings.label | default: product.title }}
          </div>

        </div>

      </div>

    {% endfor %}

  </div>

  {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
    <div class="nut-slider__cta-wrap">

      <a
        href="{{ section.settings.cta_url }}"
        class="nut-slider__cta"
      >
        {{ section.settings.cta_label }}
        <span>→</span>
      </a>

    </div>
  {% endif %}

</section>
<script>
(function () {

  function initNutSlider(sectionId) {

    var $slider = $('#nut-slider-track-' + sectionId);

    if (!$slider.length) return;

    /* Prevent duplicate init */

    if ($slider.hasClass('slick-initialized')) {
      $slider.slick('unslick');
    }

    $slider.slick({
      infinite: true,
      variableWidth: true,
      slidesToShow: 2,
      slidesToScroll: 1,
      centerMode: true,
      centerPadding: '220px',
       variableWidth: false,
      arrows: true,
      dots: false,
      autoplay: {{ section.settings.autoplay | json }},
      autoplaySpeed: {{ section.settings.autoplay_speed | times: 1000 }},
      speed: 600,
      cssEase: 'ease',

      prevArrow: $('#nut-prev-' + sectionId),
      nextArrow: $('#nut-next-' + sectionId),

      responsive: [
        {
          breakpoint: 768,
          settings: {
            variableWidth: true,
            slidesToShow: 1,
            centerMode: false,
             centerPadding: '40px'
          }
        }
      ]
    });

  }

  /* Initial load */

  document.addEventListener('DOMContentLoaded', function () {
    initNutSlider('{{ section.id }}');
  });

  /* Shopify Theme Editor Support */

  document.addEventListener('shopify:section:load', function (event) {
    initNutSlider(event.detail.sectionId);
  });

  document.addEventListener('shopify:block:select', function (event) {
    initNutSlider(event.detail.sectionId);
  });

})();
</script>

{% schema %}
{
  "name": "TJI Product Slider",
  "tag": "section",
  "class": "tji-infinite-product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recipes Made Better"
    },
    {
      "type": "text",
      "id": "pill_label",
      "label": "Pill Label",
      "default": "Pick Your Sauce"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5efe6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width",
      "min": 220,
      "max": 600,
      "step": 10,
      "default": 320
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 72
    },
    {
      "type": "range",
      "id": "cta_margin_top",
      "label": "CTA Top Margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TJI  Product Slider",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}