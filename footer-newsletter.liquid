{% comment %}
  Section: Tasty Emails Newsletter
  Place this file in: sections/newsletter-tasty-emails.liquid
  KEY FEATURES:
    - Card background = gradient (customizable colors + angle)
    - Product image overflows section top AND bottom
    - Logo image picker on right side
    - Clean form pill (no border trick)
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&display=swap" rel="stylesheet">

<style>
  /* ─────────────────────────────────────────────
     OUTER WRAPPER
  ───────────────────────────────────────────── */
  .te-wrapper {
    position: relative;
    padding-top: {{ section.settings.image_overflow_top }}px;
    padding-bottom: 35px;
    overflow: hidden;
    max-width: 1400px;
    margin-inline: auto;
  }
  .te-form-pill svg {
     width: 32px;
     height: 32px;
    }
  /* ─────────────────────────────────────────────
     CARD — GRADIENT BACKGROUND
  ───────────────────────────────────────────── */
  .te-card {
    position: relative;
    background: linear-gradient(
      {{ section.settings.bg_gradient_angle }}deg,
      {{ section.settings.bg_color_1 }} 0%,
      {{ section.settings.bg_color_2 }} 50%,
      {{ section.settings.bg_color_3 }} 100%
    );
    border-radius: {{ section.settings.border_radius }}px;
    overflow: visible;
    min-height: {{ section.settings.card_height }}px;
    display: flex;
    align-items: stretch;
    font-family: 'Barlow Condensed', sans-serif;
  }

  /* ─────────────────────────────────────────────
     LEFT COLUMN
  ───────────────────────────────────────────── */
  .te-left {
    flex: 0 0 38%;
    max-width: 38%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 20px 80px 48px;
    position: relative;
    z-index: 2;
  }

  .te-heading {
    font-weight: 900;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 28px 0;
  }

  /* ─────────────────────────────────────────────
     EMAIL FORM PILL
  ───────────────────────────────────────────── */
  .te-form-pill {
    display: flex;
    align-items: center;
    background: {{ section.settings.input_bg_color }};
    border-radius: 100px;
    padding: 13px 22px;
    gap: 12px;
    max-width: 340px;
    width: 100%;
    border: 1px solid #ffffff;
  }

  .te-form-pill .te-envelope {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    fill: {{ section.settings.input_icon_color }};
    opacity: 0.7;
  }

  .te-form-pill input[type="email"] {
    background: transparent;
    border: none;
    outline: none;
    font-family: "Antonio", sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1;
    text-transform: uppercase;
    color: {{ section.settings.input_text_color }};
    width: 100%;
  }

  .te-form-pill input[type="email"]::placeholder {
    color: {{ section.settings.input_placeholder_color }};
    opacity: 1;
  }

  .te-form-pill button { display: none; }

  .te-feedback {
    margin-top: 10px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }
  .te-feedback--error { color: #ff4444 !important; }

  /* ─────────────────────────────────────────────
     CENTER IMAGE — OVERFLOW TOP & BOTTOM
  ───────────────────────────────────────────── */
  .te-image-wrap {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: -{{ section.settings.image_overflow_top }}px;
    bottom: -{{ section.settings.image_overflow_bottom }}px;
    width: {{ section.settings.image_width }}px;
    z-index: 10;
    pointer-events: none;
  }

  .te-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* ─────────────────────────────────────────────
     RIGHT COLUMN — LOGO
  ───────────────────────────────────────────── */
  .te-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-end;
    padding: 28px 42px 28px 0;
    position: relative;
    z-index: 2;
  }

  .te-right-logo {
    display: block;
    width: {{ section.settings.right_logo_width }}px;
    height: auto;
    object-fit: contain;
    object-position: top right;
  }

  /* ─────────────────────────────────────────────
     SOCIAL ICONS
  ───────────────────────────────────────────── */
  .te-socials {
    position: absolute;
    bottom: 40px;
    right: 42px;
    display: flex;
    gap: 14px;
    align-items: center;
    z-index: 5;
  }

  .te-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2.5px solid {{ section.settings.social_icon_color }};
    color: {{ section.settings.social_icon_color }};
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .te-socials a:hover {
    background: {{ section.settings.social_icon_color }};
    color: rgba(0,0,0,0.7);
  }

  .te-socials a svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* ─────────────────────────────────────────────
     COPYRIGHT
  ───────────────────────────────────────────── */
  .te-copyright {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 6px 48px;
    font-family: "Antonio", sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: {{ section.settings.copyright_color }};
    z-index: 6;
  }

  /* ─────────────────────────────────────────────
     MOBILE
  ───────────────────────────────────────────── */
  @media (max-width: 767px) {
    .te-wrapper {
      padding-top: 0;
      padding-bottom: 30px;
    }
    .te-image-wrap img {
        position: absolute;
        top: 240px;
        max-height: 120px;
        object-fit: cover;
    }
    h2.te-heading {
        text-align: left;
    }
    .te-card {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      min-height: unset;
      overflow: hidden;
      align-items: center;
      text-align: center;
    }

    .te-left,
    .te-right {
      flex: unset;
      max-width: 100%;
    }

    .te-left  { padding: 36px 24px 20px; }

    .te-right {
        align-items: flex-start;
        padding: 0 10px 0px 0px;
        margin-left: 0;
    }

    .te-right-logo { width: 120px; }

    .te-form-pill { max-width: 100%; }

    .te-image-wrap {
      position: relative;
      top: auto; bottom: auto;
      left: auto; transform: none;
      width: 100%;
      height: 260px;
    }

    .te-socials {
      position: relative;
      bottom: auto; right: auto;
      padding: 0 24px 20px;
    }

    .te-copyright {
      position: relative;
      bottom: auto;
      padding: 10px 24px 0;
    }

    .te-heading { font-size: 48px; }
  }
</style>

<div class="te-wrapper" id="te-{{ section.id }}">
  <div class="te-card">

    <!-- ── LEFT ── -->
    <div class="te-left">
      <h2 class="te-heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}
      </h2>

      {% form 'customer', id: 'te-form-{{ section.id }}' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="te-form-pill">
          <svg xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:cc="http://creativecommons.org/ns#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:svg="http://www.w3.org/2000/svg" xmlns="http://www.w3.org/2000/svg" xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" width="800px" height="800px" viewBox="-15 -15 60.00 60.00" version="1.1" id="svg822" inkscape:version="0.92.4 (f8dce91, 2019-08-02)" sodipodi:docname="email.svg" fill="#000000">

<g id="SVGRepo_bgCarrier" stroke-width="0">

<rect x="-15" y="-15" width="60.00" height="60.00" rx="30" fill="#d8cec4" strokewidth="0"/>

</g>

<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"/>

