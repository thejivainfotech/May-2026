{% schema %}
{
  "name": "Newsletter – Tasty Emails",
  "tag": "section",
  "class": "section-te",
  "settings": [
    {
      "type": "header",
      "content": "Card Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Min Height (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "default": 360
    },
    {
      "type": "header",
      "content": "Background Gradient"
    },
    {
      "type": "range",
      "id": "bg_gradient_angle",
      "label": "Gradient Angle (deg)",
      "min": 0,
      "max": 350,
      "step": 10,
      "default": 120
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Gradient – Start Color",
      "default": "#b5a898"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Gradient – Mid Color",
      "default": "#a89888"
    },
    {
      "type": "color",
      "id": "bg_color_3",
      "label": "Gradient – End Color",
      "default": "#c2b4a6"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading – Line 1",
      "default": "WE SEND"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading – Line 2",
      "default": "TASTY EMAILS."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 32,
      "max": 100,
      "step": 2,
      "default": 72
    },
    {
      "type": "header",
      "content": "Email Input"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message (after subscribe)",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Placeholder Text",
      "default": "INSERT EMAIL ADDRESS"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input Background",
      "default": "#ccc0b5"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input Text Colour",
      "default": "#5a4a3a"
    },
    {
      "type": "color",
      "id": "input_icon_color",
      "label": "Envelope Icon Colour",
      "default": "#5a4a3a"
    },
    {
      "type": "color",
      "id": "input_placeholder_color",
      "label": "Placeholder Colour",
      "default": "#7a6a5a"
    },
    {
      "type": "header",
      "content": "Center Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product / Hand Image"
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "Product Image Alt Text",
      "default": "Product Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Column Width (px)",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 500
    },
    {
      "type": "range",
      "id": "image_overflow_top",
      "label": "Image Overflow – Top (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "image_overflow_bottom",
      "label": "Image Overflow – Bottom (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "Right Side Logo"
    },
    {
      "type": "image_picker",
      "id": "right_logo",
      "label": "Logo Image (Top Right)"
    },
    {
      "type": "text",
      "id": "right_logo_alt",
      "label": "Logo Alt Text",
      "default": "Brand Logo"
    },
    {
      "type": "range",
      "id": "right_logo_width",
      "label": "Logo Width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 140
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social Icon Colour",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Brand Name",
      "default": "THISPRODUCTCONTAINSNUTS"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright Text Colour",
      "default": "#7a6a5a"
    }
  ],
  "presets": [
    {
      "name": "Newsletter – Tasty Emails",
      "category": "Newsletter"
    }
  ]
}
{% endschema %}
