{% comment %}
  Section: Talk of the Town - Video Grid
  Theme: Savor (Shopify)
  Supports: YouTube, Vimeo, MP4 URL, Shopify Media Video
{% endcomment %}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet  = section.settings.columns_tablet
  assign columns_mobile  = section.settings.columns_mobile
  assign grid_gap        = section.settings.grid_gap
  assign border_radius   = section.settings.border_radius
  assign play_size       = section.settings.play_button_size
  assign container_width = section.settings.container_width
  assign bg_color        = section.settings.background_color
  assign heading_color   = section.settings.heading_color
  assign heading_size    = section.settings.heading_size
  assign pt              = section.settings.padding_top
  assign pb              = section.settings.padding_bottom
-%}

<section
  class="talk-of-the-town"
  style="background-color: {{ bg_color }}; padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;"
>
  <div class="talk-of-the-town__container" style="max-width: {{ container_width }}px;">

    {%- if section.settings.heading != blank -%}
      <h2
        class="talk-of-the-town__heading"
        style="color: {{ heading_color }}; font-size: {{ heading_size }}px;"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="talk-of-the-town__subheading" style="color: {{ heading_color }};">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="talk-of-the-town__grid"
        style="display: grid; grid-template-columns: repeat({{ columns_desktop }}, 1fr); gap: {{ grid_gap }}px;"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}

            {%- comment -%} --- Determine video source & thumbnail --- {%- endcomment -%}
            {%- liquid
              assign use_shopify_video = false
              assign final_video_url   = ''
              assign final_video_type  = block.settings.video_type
              assign final_thumb_url   = ''
              assign final_thumb_alt   = 'Video thumbnail'

              if block.settings.shopify_video != blank
                assign use_shopify_video = true
                assign final_video_type  = 'shopify'
                assign final_thumb_url   = block.settings.shopify_video.preview_image | image_url: width: 600
                if block.settings.shopify_video.alt != blank
                  assign final_thumb_alt = block.settings.shopify_video.alt
                elsif block.settings.video_label != blank
                  assign final_thumb_alt = block.settings.video_label
                endif
                for source in block.settings.shopify_video.sources
                  if source.format == 'mp4'
                    assign final_video_url = source.url
                  endif
                endfor
              else
                assign final_video_url = block.settings.video_url
                if block.settings.thumbnail != blank
                  assign final_thumb_url = block.settings.thumbnail | image_url: width: 600
                  if block.settings.thumbnail.alt != blank
                    assign final_thumb_alt = block.settings.thumbnail.alt
                  elsif block.settings.video_label != blank
                    assign final_thumb_alt = block.settings.video_label
                  endif
                endif
              endif
            -%}

            <div class="talk-of-the-town__item" {{ block.shopify_attributes }}>
              <div
                class="talk-of-the-town__media-wrapper"
                style="border-radius: {{ border_radius }}px;"
                role="button"
                tabindex="0"
                aria-label="Play video{%- if block.settings.video_label != blank -%}: {{ block.settings.video_label | escape }}{%- endif -%}"
                data-video-url="{{ final_video_url | escape }}"
                data-video-type="{{ final_video_type }}"
                data-autoplay="{{ block.settings.autoplay }}"
              >

                {%- comment -%} Thumbnail {%- endcomment -%}
                {%- if final_thumb_url != blank -%}
                  <img
                    class="talk-of-the-town__thumbnail"
                    src="{{ final_thumb_url }}"
                    alt="{{ final_thumb_alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="800"
                  >
                {%- else -%}
                  <div class="talk-of-the-town__thumbnail talk-of-the-town__thumbnail--placeholder">
                    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                      <rect width="100" height="100" fill="#2a2a2a"/>
                      <polygon points="38,28 72,50 38,72" fill="#666666"/>
                    </svg>
                  </div>
                {%- endif -%}

                {%- comment -%} Overlay + Play Button {%- endcomment -%}
                <div class="talk-of-the-town__overlay">
                  <span class="talk-of-the-town__play-btn" aria-hidden="true">
                    <svg
                      class="talk-of-the-town__play-icon"
                      viewBox="0 0 60 60"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      style="width: {{ play_size }}px; height: {{ play_size }}px;"
                    >
                      <circle cx="30" cy="30" r="30" fill="white" fill-opacity="0.88"/>
                      <polygon points="24,18 46,30 24,42" fill="#111111"/>
                    </svg>
                  </span>
                </div>

                {%- comment -%} Optional Label {%- endcomment -%}
                {%- if block.settings.video_label != blank and section.settings.show_labels -%}
                  <span class="talk-of-the-town__label">{{ block.settings.video_label | escape }}</span>
                {%- endif -%}

              </div>
            </div>

          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="talk-of-the-town__empty">Theme editor mein video blocks add karein.</p>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ===== VIDEO MODAL ===== {%- endcomment -%}
<div
  class="totown-modal totown-modal--closed"
  id="totown-modal-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-label="Video player"
>
  <div class="totown-modal__backdrop"></div>
  <div class="totown-modal__inner">
    <button class="totown-modal__close" type="button" aria-label="Close video">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28">
        <line x1="4" y1="4" x2="20" y2="20" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
        <line x1="20" y1="4" x2="4" y2="20" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="totown-modal__video-wrap" id="totown-video-wrap-{{ section.id }}"></div>
  </div>
</div>

<style>
  .talk-of-the-town {
    width: 100%;
    box-sizing: border-box;
  }

  .talk-of-the-town__container {
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    box-sizing: border-box;
  }

  .talk-of-the-town__heading {
    letter-spacing: 1;
    text-transform: uppercase;
    margin: 0 0 50px;
    line-height: 1.1;
  }

  .talk-of-the-town__subheading {
    font-size: 16px;
    opacity: 0.72;
    margin: 0 0 32px;
  }

  .talk-of-the-town__empty {
    opacity: 0.5;
    font-size: 14px;
    padding: 40px 0;
  }

  .talk-of-the-town__item {
    width: 100%;
    min-width: 0;
  }

  .talk-of-the-town__media-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 9 / 16;
    background: #1a1a1a;
    display: block;
  }

  .talk-of-the-town__thumbnail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .talk-of-the-town__thumbnail--placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .talk-of-the-town__thumbnail--placeholder svg {
    width: 100%;
    height: 100%;
  }

  {% comment %} .talk-of-the-town__media-wrapper:hover .talk-of-the-town__thumbnail {
    transform: scale(1.05);
  } {% endcomment %}

  .talk-of-the-town__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .talk-of-the-town__media-wrapper:hover .talk-of-the-town__overlay {
    background: rgba(0, 0, 0, 0.32);
  }

  .talk-of-the-town__play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
    pointer-events: none;
  }

  .talk-of-the-town__media-wrapper:hover .talk-of-the-town__play-btn {
    transform: scale(1.12);
  }

  .talk-of-the-town__play-icon {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
    display: block;
  }

  .talk-of-the-town__label {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    text-align: center;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.65);
    letter-spacing: 0.03em;
    padding: 0 10px;
    pointer-events: none;
  }

  /* ===== MODAL ===== */
  .totown-modal {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .totown-modal--closed {
    display: none !important;
  }

  .totown-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    cursor: pointer;
  }

  .totown-modal__inner {
    position: relative;
    z-index: 1;
    width: min(90vw, 380px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .totown-modal__close {
    position: absolute;
    top: -30px;
    right: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    line-height: 0;
    z-index: 2;
  }

  .totown-modal__close:hover {
    opacity: 0.75;
  }

  .totown-modal__video-wrap {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #000000;
    aspect-ratio: 9 / 16;
    position: relative;
  }

  .totown-modal__video-wrap iframe,
  .totown-modal__video-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (max-width: 1024px) {
    .talk-of-the-town__grid {
      grid-template-columns: repeat({{ columns_tablet }}, 1fr) !important;
    }
  }

  @media screen and (max-width: 767px) {
    .talk-of-the-town__grid {
      grid-template-columns: repeat({{ columns_mobile }}, 1fr) !important;
      gap: 10px !important;
    }
    .talk-of-the-town__heading {
      font-size: 32px !important;
    }
    .totown-modal__inner {
      width: 92vw;
    }
  }
</style>

<script>
(function () {
  var sectionId = {{ section.id | json }};
  var modal     = document.getElementById('totown-modal-' + sectionId);
  var videoWrap = document.getElementById('totown-video-wrap-' + sectionId);

  if (!modal || !videoWrap) return;

  var backdrop = modal.querySelector('.totown-modal__backdrop');
  var closeBtn = modal.querySelector('.totown-modal__close');

  function openModal(url, type, autoplay) {
    if (!url || url.trim() === '') return;
    videoWrap.innerHTML = '';
    var ap = (autoplay === 'true' || autoplay === true);
    var el;

    if (type === 'shopify' || type === 'mp4' || type === 'self') {
      /* Shopify hosted video or direct MP4 */
      el = document.createElement('video');
      el.src = url;
      el.controls = true;
      el.playsinline = true;
      el.setAttribute('webkit-playsinline', '');
      if (ap) { el.autoplay = true; }

    } else if (type === 'vimeo') {
      var vid = (url.match(/vimeo\.com\/(\d+)/) || [])[1] || url;
      el = document.createElement('iframe');
      el.src = 'https://player.vimeo.com/video/' + vid + (ap ? '?autoplay=1' : '');
      el.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
      el.allowFullscreen = true;

    } else {
      /* YouTube (default) */
      var yid = (url.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([A-Za-z0-9_-]{11})/) || [])[1] || url;
      el = document.createElement('iframe');
      el.src = 'https://www.youtube-nocookie.com/embed/' + yid + '?rel=0' + (ap ? '&autoplay=1' : '');
      el.setAttribute('allow', 'autoplay; encrypted-media; fullscreen; picture-in-picture');
      el.allowFullscreen = true;
    }

    videoWrap.appendChild(el);
    modal.classList.remove('totown-modal--closed');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('totown-modal--closed');
    videoWrap.innerHTML = '';
    document.documentElement.style.overflow = '';
  }

  /* Click delegation — works for all cards on page */
  document.addEventListener('click', function (e) {
    var wrapper = e.target.closest ? e.target.closest('.talk-of-the-town__media-wrapper') : null;
    if (!wrapper) return;
    openModal(
      wrapper.getAttribute('data-video-url')  || '',
      wrapper.getAttribute('data-video-type') || 'youtube',
      wrapper.getAttribute('data-autoplay')   || 'true'
    );
  });

  /* Keyboard: Enter / Space */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      var wrapper = document.activeElement
        ? (document.activeElement.closest ? document.activeElement.closest('.talk-of-the-town__media-wrapper') : null)
        : null;
      if (wrapper) {
        e.preventDefault();
        openModal(
          wrapper.getAttribute('data-video-url')  || '',
          wrapper.getAttribute('data-video-type') || 'youtube',
          wrapper.getAttribute('data-autoplay')   || 'true'
        );
      }
    }
    if (e.key === 'Escape' && !modal.classList.contains('totown-modal--closed')) {
      closeModal();
    }
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click',  closeModal);
})();
</script>

{% schema %}
{
  "name": "Talk of the Town",
  "tag": "section",
  "class": "section-talk-of-the-town",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "WE ARE THE TALK OF THE TOWN"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns - Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns - Tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns - Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap Between Videos (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card Corner Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Max Container Width (px)",
      "min": 800,
      "max": 1800,
      "step": 20,
      "default": 1400
    },
    {
      "type": "header",
      "content": "Play Button"
    },
    {
      "type": "range",
      "id": "play_button_size",
      "label": "Play Button Size (px)",
      "min": 40,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show video labels on cards",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Card",
      "settings": [
        {
          "type": "header",
          "content": "Shopify Media Video"
        },
        {
          "type": "video",
          "id": "shopify_video",
          "label": "Shopify Media se Video Select Karein",
          "info": "Shopify Files mein upload ki gayi video yahan se select karein. Agar yeh set hai toh neeche wale URL field ko ignore kiya jayega."
        },
        {
          "type": "header",
          "content": "Ya External Video URL"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "placeholder": "https://www.youtube.com/watch?v=...",
          "info": "YouTube, Vimeo, ya direct MP4 link. Shopify video select kiya hai toh yeh field kaam nahi karega."
        },
        {
          "type": "select",
          "id": "video_type",
          "label": "Video Platform",
          "options": [
            { "value": "youtube", "label": "YouTube" },
            { "value": "vimeo",   "label": "Vimeo"   },
            { "value": "mp4",     "label": "MP4 (Self-hosted)" }
          ],
          "default": "youtube"
        },
        {
          "type": "header",
          "content": "Thumbnail"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Custom Thumbnail Image",
          "info": "Sirf external URL ke liye. Shopify video ka thumbnail automatically use hoga."
        },
        {
          "type": "header",
          "content": "Options"
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay when modal opens",
          "default": true
        },
        {
          "type": "text",
          "id": "video_label",
          "label": "Card Label (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Talk of the Town",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
