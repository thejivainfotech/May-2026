{% comment %} Feature Badges Banner Section — Full Dynamic Liquid {% endcomment %}

<style>
  #fbb-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
  }

  /* Background Image */
  #fbb-{{ section.id }} .fbb-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position }};
    z-index: 0;
  }

  /* Placeholder BG (if no image) */
  #fbb-{{ section.id }} .fbb-bg-placeholder {
    position: absolute;
    inset: 0;
    background: {{ section.settings.fallback_bg_color }};
    z-index: 0;
  }

  /* Overlay */
  #fbb-{{ section.id }} .fbb-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  /* Badge Grid */
  #fbb-{{ section.id }} .fbb-grid {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ section.settings.badges_justify }};
    gap: {{ section.settings.badge_gap }}px;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Single Badge / Pill */
  #fbb-{{ section.id }} .fbb-badge {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.icon_text_gap }}px;
    background: {{ section.settings.badge_bg_color }};
    opacity: 1;
    backdrop-filter: blur({{ section.settings.badge_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.badge_blur }}px);
    border-radius: {{ section.settings.badge_radius }}px;
    padding: {{ section.settings.badge_padding_v }}px {{ section.settings.badge_padding_h }}px;
    border: {{ section.settings.badge_border_width }}px solid {{ section.settings.badge_border_color }};
    box-shadow: 0 4px 24px rgba(0,0,0,{{ section.settings.badge_shadow | divided_by: 100.0 }});
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  {% comment %} #fbb-{{ section.id }} .fbb-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,{{ section.settings.badge_shadow | divided_by: 100.0 | plus: 0.1 }});
  } {% endcomment %}

  /* Icon Circle */
  #fbb-{{ section.id }} .fbb-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #fbb-{{ section.id }} .fbb-icon svg {
    width: {{ section.settings.icon_size | times: 0.55 | round }}px;
    height: {{ section.settings.icon_size | times: 0.55 | round }}px;
  }

  /* Badge Text */
  #fbb-{{ section.id }} .fbb-label {
    font-size: 32px;
    font-weight: {{ section.settings.badge_font_weight }};
    color: {{ section.settings.badge_text_color }};
    text-transform: {{ section.settings.badge_text_transform }};
    letter-spacing: {{ section.settings.badge_letter_spacing }}px;
    white-space: nowrap;
    line-height: 1;
    font-family: "Antonio", sans-serif;
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    #fbb-{{ section.id }} .fbb-grid {
      justify-content: center;
    }
    #fbb-{{ section.id }} .fbb-badge {
      flex: 0 1 calc(50% - {{ section.settings.badge_gap }}px);
      justify-content: center;
    }
    #fbb-{{ section.id }} .fbb-label {
      font-size: {{ section.settings.badge_font_size | minus: 2 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    #fbb-{{ section.id }} .fbb-badge {
      flex: 0 1 100%;
    }
  }
</style>

<div id="fbb-{{ section.id }}">

  {%- comment %} Background Image {%- endcomment %}
  {%- if section.settings.bg_image != blank -%}
    {{
      section.settings.bg_image
      | image_url: width: 2000
      | image_tag:
        class: 'fbb-bg',
        alt: section.settings.bg_image.alt | default: 'section background',
        loading: 'lazy',
        widths: '600, 900, 1200, 1600, 2000'
    }}
  {%- else -%}
    <div class="fbb-bg-placeholder"></div>
  {%- endif -%}

  {%- comment %} Overlay {%- endcomment %}
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="fbb-overlay"></div>
  {%- endif -%}

  {%- comment %} Badge Grid {%- endcomment %}
  <div class="fbb-grid">

    {%- for block in section.blocks -%}
      {%- if block.type == 'badge' and block.settings.label != blank -%}
        <div class="fbb-badge" {{ block.shopify_attributes }}>

          {%- comment %} Icon Circle {%- endcomment %}
          {%- if block.settings.show_icon -%}
            <div class="fbb-icon"
              style="background:{{ block.settings.icon_bg_color | default: section.settings.icon_bg_color }};">
              {%- case block.settings.icon_type -%}
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                {%- when 'bolt' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <path d="M17 8C8 10 5.9 16.17 3.82 19.34A1 1 0 004.7 21C8 19 12.6 17 17 8zm0 0s-2 7-9 11"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                {%- when 'fire' -%}
                  <svg viewBox="0 0 24 24" fill="{{ block.settings.icon_color | default: section.settings.icon_color }}" stroke="none">
                    <path d="M12 2c0 0-5 5-5 10a5 5 0 0010 0c0-3-2-6-2-6s-1 3-3 4c0 0 1-5 0-8z"/>
                  </svg>
              {%- endcase -%}
            </div>
          {%- endif -%}

          {%- comment %} Label {%- endcomment %}
          <span class="fbb-label"
            style="
              color: {{ block.settings.label_color | default: section.settings.badge_text_color }};
              font-size: {{ block.settings.label_size | default: section.settings.badge_font_size }}px;
            ">
            {{ block.settings.label }}
          </span>

        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "Feature Badges Banner",
  "tag": "section",
  "class": "feature-badges-banner",
  "max_blocks": 8,

  "settings": [

    {
      "type": "header",
      "content": "🖼️ Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top",    "label": "Top"    },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center",   "label": "Left"   },
        { "value": "right center",  "label": "Right"  }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "fallback_bg_color",
      "label": "Fallback Background Color",
      "default": "#c0441a"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 0
    },

    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Min Height (px)",
      "min": 80,
      "max": 600,
      "step": 10,
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "Padding Top/Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_h",
      "label": "Padding Left/Right (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Max Width (px)",
      "min": 400,
      "max": 1600,
      "step": 40,
      "default": 1200
    },
    {
      "type": "select",
      "id": "badges_justify",
      "label": "Badges Alignment",
      "options": [
        { "value": "center",        "label": "Center"        },
        { "value": "flex-start",    "label": "Left"          },
        { "value": "flex-end",      "label": "Right"         },
        { "value": "space-between", "label": "Space Between" },
        { "value": "space-around",  "label": "Space Around"  }
      ],
      "default": "space-between"
    },
    {
      "type": "range",
      "id": "badge_gap",
      "label": "Gap Between Badges (px)",
      "min": 4,
      "max": 80,
      "step": 4,
      "default": 20
    },

    {
      "type": "header",
      "content": "💊 Badge Style"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#c8703a99"
    },
    {
      "type": "range",
      "id": "badge_blur",
      "label": "Badge Backdrop Blur (px)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Badge Border Radius (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "badge_padding_v",
      "label": "Badge Padding Vertical (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_padding_h",
      "label": "Badge Padding Horizontal (px)",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "badge_border_width",
      "label": "Badge Border Width (px)",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Badge Border Color",
      "default": "#ffffff33"
    },
    {
      "type": "range",
      "id": "badge_shadow",
      "label": "Badge Shadow Intensity (%)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20
    },

    {
      "type": "header",
      "content": "✏️ Badge Text"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Default Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Default Font Size (px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "800"
    },
    {
      "type": "select",
      "id": "badge_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "uppercase",  "label": "UPPERCASE"  },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "none",       "label": "None"       }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "badge_letter_spacing",
      "label": "Letter Spacing (px)",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "default": 1
    },

    {
      "type": "header",
      "content": "✅ Default Icon Style"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Default Icon Circle BG",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Default Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Circle Size (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to Text Gap (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 14
    }

  ],

  "blocks": [
    {
      "type": "badge",
      "name": "Badge Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Badge Text",
          "default": "Same Cravings"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "check",  "label": "✔ Checkmark" },
            { "value": "star",   "label": "★ Star"      },
            { "value": "heart",  "label": "♥ Heart"     },
            { "value": "bolt",   "label": "⚡ Bolt"     },
            { "value": "leaf",   "label": "🌿 Leaf"     },
            { "value": "shield", "label": "🛡 Shield"   },
            { "value": "fire",   "label": "🔥 Fire"     }
          ],
          "default": "check"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show Icon",
          "default": true
        },
        {
          "type": "color",
          "id": "icon_bg_color",
          "label": "Icon Circle BG (override)",
          "default": "#1a2a3a"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color (override)",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Text Color (override)",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "label_size",
          "label": "Text Size Override (px)",
          "min": 10,
          "max": 40,
          "step": 1,
          "default": 18
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Feature Badges Banner",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "label": "Same Cravings",
            "icon_type": "check"
          }
        },
        {
          "type": "badge",
          "settings": {
            "label": "More Flavor",
            "icon_type": "check"
          }
        },
        {
          "type": "badge",
          "settings": {
            "label": "More Benefits",
            "icon_type": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}